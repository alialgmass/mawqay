APP_NAME=THOB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Local/dev default: SQLite. Production target: MySQL 8 (uncomment the block).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=thob
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@thob.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth / OTP (Modules/Auth) ----------------------------------------------
# OtpSender binding. `log` records only that a code was issued, never the code
# (SEC-NFR-02). `capture` (local/testing ONLY â€” refused in production) stashes the
# plaintext in the cache under `otp:{phone}` so you can read it back while testing
# the flow by hand. Add real SMS-provider keys under AuthServiceProvider::OTP_DRIVERS.
OTP_DRIVER=log

# --- Verification documents (Modules/Verification) --------------------------
# Disk name + driver for verification documents. `local` in dev; `s3` (private
# bucket, SSE) in production.
VERIFICATION_DISK=verification
VERIFICATION_DISK_DRIVER=local
# Malware scan on uploads (SEC-NFR-05): `signature` (EICAR check, no deps),
# `null` (off), or a real ClamAV/hosted adapter registered in the provider.
VERIFICATION_SCANNER=signature

# --- Catalog review gating (Modules/Catalog, BR-SEL-02) --------------------
# New products enter pending_review before going public when true. A material
# edit re-enters review when CATALOG_REVIEW_EDIT is true (default off).
CATALOG_REVIEW_CREATE=true
CATALOG_REVIEW_EDIT=false
# Private disk the bulk-import CSV is stashed on for the queued job (Phase 3.3).
PRODUCT_IMPORT_DISK=local

# --- S3 (verification docs in prod; product media later) -------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Chat realtime (Modules/Chat, Phase 7) --------------------------------
# MySQL is the source of truth; Pusher is a best-effort delivery layer. `log`
# in dev/test, `pusher` in production. A broadcast failure never fails a send.
# BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# --- Notifications (Modules/Notifications, Phase 8) -----------------------
# Push + SMS are seams with a `log` default (no vendor in the SRS). `null`
# discards; a real FCM/APNs/gateway adapter is bound in the module provider.
# Firebase service-account JSON (kept out of git; storage/app/private is ignored).
FCM_CREDENTIALS=storage/app/private/firebase/fcm-service-account.json
NOTIFICATIONS_PUSH_DRIVER=log
NOTIFICATIONS_SMS_DRIVER=log
# Days before period end that subscriptions:notify-expiring reminds the seller.
SUBSCRIPTION_EXPIRING_REMINDER_DAYS=7

# --- Telescope (local debugging) -----------------------------------------------
# Keep Telescope off outside local development; when on elsewhere it is open to Platform Admins only.
TELESCOPE_ENABLED=true

# --- Security -----------------------------------------------------------------
# Every Platform Admin must use an authenticator app. Leave true in every real environment.
ADMIN_MFA_REQUIRED=true

# --- Private files ------------------------------------------------------------
# Receipts and payout proofs must stay on a private disk, never a public one.
PAYMENTS_DISK=local

# --- Later phases (not wired yet) --------------------------------------------
# Payments (R4): payment-provider hosted-checkout keys â€” no card data ever touches THOB
