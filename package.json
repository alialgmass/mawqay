{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:filament": "vite build --config vite.filament.config.ts",
        "build:ssr": "vite build && vite build --ssr",
